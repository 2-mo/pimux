# pimux-managed: shared Bash prompt for tmux and ordinary terminals.
case $- in
    *i*) ;;
    *) return ;;
esac

source "$(dirname -- "${BASH_SOURCE[0]}")/runtime.bash"
# User rc files and tmux clients may reset PATH. Restore the selected runtimes
# before prompt hooks call tmux, including when Bash and tmux live separately.
if [[ ${PIMUX_TMUX:-} == /* && -x $PIMUX_TMUX ]]; then
    export PATH="${PIMUX_TMUX%/*}:$PATH"
fi
pimux_bootstrap "${BASH_SOURCE[0]}" || return

case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

if command -v starship >/dev/null 2>&1; then
    export STARSHIP_CONFIG="$HOME/.config/pimux/starship.toml"
    if [[ -f $(dirname -- "${BASH_SOURCE[0]}")/../config/starship.toml ]]; then
        export STARSHIP_CONFIG="$(dirname -- "${BASH_SOURCE[0]}")/../config/starship.toml"
    fi
    # STARSHIP_SHELL is inherited by tmux and nested shells; functions are not.
    if ! declare -F starship_precmd >/dev/null; then
        eval "$(starship init bash)"
    fi
fi

source "$(dirname -- "${BASH_SOURCE[0]}")/environment.bash"
pimux_environment_shell_init
source "$(dirname -- "${BASH_SOURCE[0]}")/proxy.bash"
pimux_proxy_shell_init
source "$(dirname -- "${BASH_SOURCE[0]}")/command_status.bash"
pimux_command_status_init
